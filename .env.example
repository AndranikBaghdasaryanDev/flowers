# ─── Required ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (Atlas clusters are replica sets, which order
# transactions require). For local development run `npm run db:local` and use
# mongodb://127.0.0.1:27017/?replicaSet=floriani
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=floriani

# Public base URL of the site, used in emails and canonical/OG URLs.
APP_URL=http://localhost:3000

# ─── Email (optional but recommended) ────────────────────────────────────────
# Without SMTP, order/password/verification emails are NOT sent; the admin shows
# them as "skipped". Any SMTP provider works (Postmark, SendGrid, Mailgun, SES...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Floriani Flowers <orders@example.com>"

# ─── Uploads ─────────────────────────────────────────────────────────────────
# Maximum size of a single image upload, in megabytes.
MAX_UPLOAD_MB=8

# ─── First owner account (used by `npm run create-owner`) ────────────────────
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=
